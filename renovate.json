{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:netcracker-dependencies"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/target/**",
    ".graylog/**",
    ".m2/**"
  ],
  "packageRules": [
    {
      "description": "Keep the plugin on the Graylog 5.x line.",
      "matchPackageNames": [
        "org.graylog.plugins:graylog-plugin-parent",
        "org.graylog2:graylog2-server",
        "graylog/graylog"
      ],
      "allowedVersions": "/^5\\./",
      "groupName": "Graylog 5.x"
    },
    {
      "description": "Keep the custom Graylog image version tag-only",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["graylog/graylog"],
      "pinDigests": false
    },
    {
      "description": "Keep the integration stack on the tested OpenSearch 2.15 line",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["opensearchproject/opensearch"],
      "allowedVersions": "<2.16.0"
    },
    {
      "description": "Keep the integration stack on the tested MongoDB 7.x line",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mongo"],
      "allowedVersions": "<8.0.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["GRAYLOG_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "maven",
      "depNameTemplate": "org.graylog2:graylog2-server",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)src/integration-test/graylog/docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "graylog/graylog:\\$\\{GRAYLOG_VERSION:-(?<currentValue>[^}]+)\\}"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "graylog/graylog"
    }
  ]
}
